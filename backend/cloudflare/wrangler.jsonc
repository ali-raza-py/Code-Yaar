{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "code-yaar",
  "main": "worker.py",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 10
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_NON_PRODUCTION_HYPERDRIVE_CONFIG_ID"
    }
  ]
}
