SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Browser origins allowed to call the API. localhost and 127.0.0.1 are
# different origins and Next.js answers on both, so list both in development
# (a missing one shows up in the browser as "Failed to fetch").
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public origin of the frontend. Certificate QR codes and verification
# links point to {SITE_URL}/verify/<id>/ — must be the real https origin
# in production (include the scheme).
SITE_URL=http://localhost:3000

# Origins used to build verification / password-reset links inside emails.
# FRONTEND_URL is the Next.js app; BACKEND_URL is this API.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000

# --- Authentication ---
# Access tokens are short-lived; refresh tokens are HttpOnly cookies.
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
# Set to True in production only when the API is served over HTTPS.
AUTH_REFRESH_COOKIE_SECURE=False
# Refuse sign-in, enrolment, submission and certificate issuance until the
# address is verified. Leave it unset to follow the mail transport (the gate
# turns itself on once SMTP has a password); set True/False to force it.
# AUTH_REQUIRE_EMAIL_VERIFICATION=True
AUTH_EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_PASSWORD_RESET_TTL_MINUTES=60

# --- Email ---
# The console backend only prints messages to the API window; nothing is
# delivered. To send real verification / reset mail, switch to SMTP below.
#
# Gmail (what this project uses): the password is NOT your account password.
#   Google Account > Security > 2-Step Verification > App passwords
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=the-16-character-app-password
#   EMAIL_USE_TLS=True
#   DEFAULT_FROM_EMAIL="Code Yaar <you@gmail.com>"
#
# Gmail only accepts your own address (or a verified alias) as the sender.
# Verify the setup with: python manage.py mail_check you@gmail.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Code Yaar <no-reply@codeyaar.dev>
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# Rate limits for credential endpoints (DRF throttle syntax).
# THROTTLE_AUTH_LOGIN=10/min
# THROTTLE_AUTH_REGISTER=10/hour
# THROTTLE_AUTH_RESEND_VERIFICATION=5/hour
# THROTTLE_AUTH_PASSWORD_RESET=5/hour
# THROTTLE_AUTH_PASSWORD_RESET_CONFIRM=10/hour
# THROTTLE_AUTH_CHANGE_PASSWORD=10/hour
# THROTTLE_AUTH_REFRESH=120/min

# Default final-assessment passing percentage for certification.
CERT_PASSING_SCORE=70

# Local PostgreSQL development database.
# Leave DB_NAME empty (or set DB_ENGINE=sqlite) to use SQLite for local dev.
# DB_ENGINE=sqlite
DB_NAME=code_yaar
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Production extras ---
# Behind an https-terminating reverse proxy (nginx/traefik):
# USE_X_FORWARDED_PROTO=True
# Extra origins allowed to send session cookies / CSRF forms:
# CSRF_TRUSTED_ORIGINS=https://api.example.com
# HSTS lifetime in seconds (default 31536000 when DEBUG=False):
# SECURE_HSTS_SECONDS=31536000
