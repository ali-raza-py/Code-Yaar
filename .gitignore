# Sindh Board source textbooks (hundreds of MB) and their rendered page extracts
textbooks/

# Agent/tool scratch output and throwaway backups; never commit these
.opencode/
*.bak
*_diff.txt

# TypeScript incremental-build cache (regenerated by every build)
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo