# Python
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class

# Django local files
backend/db.sqlite3
backend/media/
backend/staticfiles/

# Environment files
.env
.env.*
!.env.example

# Node / frontend
node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/

# IDE and operating system files
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Throwaway diagnostics from local debugging; never commit these
.tmp_*
.tmp-*
